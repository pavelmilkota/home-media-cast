# Copy to .env on the host. Real values never go in git.
# Port the API (and the built web UI) listens on.
PORT=8787
# Kodi JSON-RPC over WebSocket. Must be a loopback address: Kodi has no authentication.
KODI_WS_URL=ws://127.0.0.1:9090/jsonrpc
# SQLite file (paired devices, library, source list cache). Keep it on a persistent volume. Default: ./data/home-media-cast.sqlite
DB_PATH=./data/home-media-cast.sqlite
# Hosts a pasted link may point to even though they are on the LAN, comma-separated
# (e.g. a self-hosted AIOStreams on the LAN). Empty = every private, loopback and tailnet
# address is refused. A hosted, public HTTPS instance needs no entry.
PLAYBACK_ALLOW_HOSTS=
# YouTube Cast. Initial state of the "YouTube casting" switch; a value saved from the
# app wins over it. Needs UDP 1900 and YOUTUBE_DIAL_PORT open from the LAN (scripts/ufw-setup.sh).
YOUTUBE_CAST_ENABLED=false
YOUTUBE_DIAL_PORT=3100
# Name shown in the YouTube app's Cast menu.
YOUTUBE_DEVICE_NAME=homeMediaCast

# AIOStreams. Base URL of your instance (self-hosted, e.g. http://192.168.1.10:3000, or a
# hosted one, e.g. https://aiostreams.example.com), and the uuid and password of the user
# configuration the backend searches with. Real values only in .env.
AIOSTREAMS_URL=
AIOSTREAMS_UUID=
AIOSTREAMS_PASSWORD=
# Cinemeta, the title catalog. Leave empty to use the public instance.
CINEMETA_URL=
# Play the next episode by itself when one ends, from the same release group (default true).
AUTO_NEXT_EPISODE=true
# A device that is not paired may register itself as a guest and play in the browser, with no TV
# control and no writes to the library (ADR-0009). false: every device must pair first.
GUEST_PLAYBACK_ENABLED=true
# Host directory shared with the API for the "Restart Kodi" button (docs/kodi-setup.md). Create it
# first and make it writable by uid 1000. The systemd path unit watches kodi-restart in it.
KODI_RESTART_DIR=/home/YOUR_USER/.local/share/home-media-cast/restart

# Browser playback (ffmpeg). Numeric GID of the host's `render` group: `getent group render`.
RENDER_GID=992
# The Intel GPU's render node. Two nodes exist on the Dell: renderD129 is i915 (Intel), renderD128 is Nvidia.
TRANSCODE_VAAPI_DEVICE=/dev/dri/renderD129
# Size of /tmp in the container, where HLS segments are kept (RAM).
TRANSCODE_TMPFS_SIZE=1g
# Segments (4 s each) ffmpeg may run in front of the browser player, and keeps behind it.
BROWSER_AHEAD_SEGMENTS=12
BROWSER_BEHIND_SEGMENTS=6
# What to do with video the browser cannot decode (at most 1080p): vaapi (GPU encoder), software
# (libx264, heavy on the CPU) or off (such sources show "TV only"). Decoding on the GPU too is
# only for hosts whose GPU decodes the source codec (the Dell cannot do HEVC 10-bit; the NUC can).
TRANSCODE=vaapi
TRANSCODE_HW_DECODE=false

# Kodi's log directory (flatpak path), mounted read-only for the Logs page (docs/kodi-setup.md).
# Without it the Logs page's Kodi tab says the log is unavailable. Readable by uid 1000.
KODI_LOG_DIR=/home/YOUR_USER/.var/app/tv.kodi.Kodi/data/temp
